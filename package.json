{
  "name": "cortex",
  "version": "0.3.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:log": "bun test 2>&1 | tee test-output.log",
    "db:migrate": "bunx prisma migrate deploy",
    "db:generate": "bunx prisma generate",
    "import": "bun run src/import.ts --"
  },
  "dependencies": {
    "@elysiajs/swagger": "latest",
    "@huggingface/transformers": "^3.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/client": "^6.0.0",
    "elysia": "latest",
    "marked": "^18.1.3",
    "prisma": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "latest"
  }
}
