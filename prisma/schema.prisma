generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Note {
  id         String    @id
  title      String
  body_md    String
  app        String
  kind       String
  tags       Json      @default("[]")
  author     String
  issue      String?
  rev        Int       @default(1)
  /// tsvector columna FTS — mantenida por trigger; leer vía $queryRaw
  fts        Unsupported("tsvector")?
  /// vector(768) pgvector — escribir/leer vía $executeRaw / $queryRaw
  embedding  Unsupported("vector(768)")?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  revisions  NoteRevision[]

  // Índices declarados también en el SQL de la migración. Sin estas líneas,
  // `prisma migrate dev` interpreta que los índices sobran y propone migraciones
  // que los borran (incluido el GIN de la búsqueda de texto).
  // El índice HNSW del embedding y el parcial de deleted_at no se pueden expresar
  // en el datamodel: quedan solo en el SQL de la migración.
  @@index([app], map: "notes_app_idx")
  @@index([kind], map: "notes_kind_idx")
  @@index([fts], type: Gin, map: "notes_fts_gin")
  @@map("notes")
}

model NoteRevision {
  note_id    String
  rev        Int
  title      String
  body_md    String
  tags       Json      @default("[]")
  author     String
  reason     String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  note       Note      @relation(fields: [note_id], references: [id])

  @@id([note_id, rev])
  @@map("note_revisions")
}
